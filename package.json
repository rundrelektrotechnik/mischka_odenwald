{
  "name": "mischka-odenwald-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static site for Mischka Odenwald. No dependencies, no build framework.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev.mjs",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "build:prod": "node scripts/build.mjs && node scripts/preview.mjs --out dist/site"
  },
  "engines": {
    "node": ">=18"
  }
}
